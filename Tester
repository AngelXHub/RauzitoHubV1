    entries[player] = {
        box       = box,
        boxStroke = boxStroke,
        name      = name,
        dist      = dist,
        health    = health,
        healthBg  = healthBg,
        tracer    = tracer,
        highlight = nil,
    }
end

local function destroyEntry(player)
    local e = entries[player]
    if not e then return end
    for _, v in pairs(e) do
        if typeof(v) == "Instance" then
            pcall(function() v:Destroy() end)
        end
    end
    entries[player] = nil
end

local function getHighlight(player)
    local e = entries[player]
    if not e then return nil end
    if e.highlight and e.highlight.Parent then return e.highlight end
    local char = player.Character
    if not char then return nil end
    local h = Instance.new("Highlight")
    h.Name = "LpModsHL"
    h.FillColor = Settings.AccentColor
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.FillTransparency = 0.7
    h.OutlineTransparency = 0.2
    h.Adornee = char
    h.Parent = char
    e.highlight = h
    return h
end

local function clearHighlight(player)
    local e = entries[player]
    if e and e.highlight then
        pcall(function() e.highlight:Destroy() end)
        e.highlight = nil
    end
end

local function drawFor(player)
    local e = entries[player]
    if not e then return end

    local char = player.Character
    local head = char and char:FindFirstChild("Head")
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")

    if not (char and head and hrp and hum and hum.Health > 0) then
        e.box.Visible = false
        e.name.Visible = false
        e.dist.Visible = false
        e.healthBg.Visible = false
        e.tracer.Visible = false
        clearHighlight(player)
        return
    end

    if Settings.ESP.TeamCheck and TeamCheck.shouldIgnore(player) then
        e.box.Visible = false
        e.name.Visible = false
        e.dist.Visible = false
        e.healthBg.Visible = false
        e.tracer.Visible = false
        clearHighlight(player)
        return
    end

    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if myHRP then
        local d = (hrp.Position - myHRP.Position).Magnitude
        if d > Settings.ESP.MaxDistance then
            e.box.Visible = false
            e.name.Visible = false
            e.dist.Visible = false
            e.healthBg.Visible = false
            e.tracer.Visible = false
            clearHighlight(player)
            return
        end
        e.dist.Text = tostring(math.floor(d)) .. "m"
    end

    local topPos    = Targeting.screenPos(head.Position + Vector3.new(0, 0.5, 0))
    local bottomPos = Targeting.screenPos(hrp.Position - Vector3.new(0, 3, 0))

    if topPos and bottomPos then
        local height = math.abs(bottomPos.Y - topPos.Y)
        local width  = height * 0.6

        e.box.Size = UDim2.fromOffset(width, height)
        e.box.Position = UDim2.fromOffset(topPos.X - width / 2, topPos.Y)
        e.box.Visible = Settings.ESP.Box

        e.name.Text = player.Name
        e.name.Size = UDim2.fromOffset(width + 60, 16)
        e.name.Position = UDim2.fromOffset(topPos.X - (width + 60) / 2, topPos.Y - 20)
        e.name.Visible = Settings.ESP.Name

        e.dist.Size = UDim2.fromOffset(width + 60, 14)
        e.dist.Position = UDim2.fromOffset(topPos.X - (width + 60) / 2, topPos.Y + height + 2)
        e.dist.Visible = Settings.ESP.Distance

        e.healthBg.Size = UDim2.fromOffset(4, height)
        e.healthBg.Position = UDim2.fromOffset(topPos.X - width / 2 - 8, topPos.Y)
        e.healthBg.Visible = Settings.ESP.Health
        e.health.Size = UDim2.new(1, 0, hum.Health / hum.MaxHealth, 0)
        local pct = hum.Health / hum.MaxHealth
        e.health.BackgroundColor3 = Color3.fromRGB(
            255 - 175 * pct,
            80 + 140 * pct,
            120
        )
    else
        e.box.Visible = false
        e.name.Visible = false
        e.dist.Visible = false
        e.healthBg.Visible = false
    end

    if Settings.ESP.Tracer then
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        local target = Targeting.screenPos(hrp.Position)
        if target then
            local dx = target.X - center.X
            local dy = target.Y - center.Y
            local len = math.sqrt(dx * dx + dy * dy)
            local ang = math.atan2(dy, dx)
            e.tracer.Size = UDim2.fromOffset(len, 1)
            e.tracer.Position = UDim2.fromOffset(center.X, center.Y)
            e.tracer.Rotation = math.deg(ang)
            e.tracer.Visible = true
        else
            e.tracer.Visible = false
        end
    else
        e.tracer.Visible = false
    end

    if Settings.ESP.Highlight then
        local h = getHighlight(player)
        if h then h.Adornee = char end
    else
        clearHighlight(player)
    end
end

local espConn = nil
local function espStep()
    for player, _ in pairs(entries) do
        drawFor(player)
    end
end

function ESP.start()
    if espConn then return end
    espConn = RunService.RenderStepped:Connect(espStep)
end

function ESP.stop()
    if espConn then espConn:Disconnect(); espConn = nil end
end

function ESP.setupPlayer(player)
    if player == LocalPlayer then return end
    if not entries[player] then createEntry(player) end
end

function ESP.removePlayer(player)
    destroyEntry(player)
end

function ESP.clearAll()
    for player, _ in pairs(entries) do
        destroyEntry(player)
    end
    if espFolder then espFolder:Destroy(); espFolder = nil end
end

function ESP.isActive()
    return Settings.ESP.Box or Settings.ESP.Tracer or Settings.ESP.Name
        or Settings.ESP.Distance or Settings.ESP.Health or Settings.ESP.Highlight
end

local fovCircle = nil

local function ensureFovCircle()
    if fovCircle and fovCircle.Parent then return fovCircle end
    local screen = getDrawScreen()
    local circle = Instance.new("Frame")
    circle.Name = "FOVCircle"
    circle.BackgroundTransparency = 1
    circle.BorderSizePixel = 0
    circle.AnchorPoint = Vector2.new(0.5, 0.5)
    circle.ZIndex = 0
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.6
    stroke.Color = Settings.AccentColor
    stroke.Parent = circle
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = circle
    circle.Parent = screen
    fovCircle = circle
    return circle
end

local function updateFovCircle()
    if not Settings.Aim.Enabled or not Settings.Aim.ShowFOV then
        if fovCircle then fovCircle.Visible = false end
        return
    end
    local c = ensureFovCircle()
    local size = Settings.Aim.FOV * 2
    c.Size = UDim2.fromOffset(size, size)
    c.Position = UDim2.fromOffset(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    c.Visible = true
    c.UIStroke.Color = Settings.AccentColor
end

local Cleanup = {}

function Cleanup.bind()
    Players.PlayerAdded:Connect(function(p)
        ESP.setupPlayer(p)
    end)
    Players.PlayerRemoving:Connect(function(p)
        ESP.removePlayer(p)
    end)
    for _, p in ipairs(Players:GetPlayers()) do
        ESP.setupPlayer(p)
    end
end

