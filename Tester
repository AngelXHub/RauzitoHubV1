local ESP = {}

local espFolder = nil
local entries = {}

local function makeEspFolder()
    if espFolder and espFolder.Parent then return espFolder end
    espFolder = Instance.new("Folder")
    espFolder.Name = "LpModsESP"
    espFolder.Parent = getParent()
    return espFolder
end

local function getDrawScreen()
    local folder = makeEspFolder()
    local screen = folder:FindFirstChild("Draw")
    if not screen then
        screen = Instance.new("ScreenGui")
        screen.Name = "Draw"
        screen.ResetOnSpawn = false
        screen.IgnoreGuiInset = true
        screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screen.Parent = folder
    end
    return screen
end

local function createEntry(player)
    local screen = getDrawScreen()

    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.ZIndex = 2
    box.Parent = screen
    local boxStroke = Instance.new("UIStroke")
    boxStroke.Thickness = 1.4
    boxStroke.Color = Settings.ESP.BoxColor
    boxStroke.Parent = box

    local name = Instance.new("TextLabel")
    name.BackgroundTransparency = 1
    name.TextColor3 = Color3.fromRGB(235, 230, 255)
    name.Font = Enum.Font.GothamBold
    name.TextSize = 13
    name.TextStrokeTransparency = 0
    name.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    name.Visible = false
    name.ZIndex = 3
    name.Parent = screen

    local dist = Instance.new("TextLabel")
    dist.BackgroundTransparency = 1
    dist.TextColor3 = Color3.fromRGB(200, 200, 220)
    dist.Font = Enum.Font.Gotham
    dist.TextSize = 12
    dist.TextStrokeTransparency = 0
    dist.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    dist.Visible = false
    dist.ZIndex = 3
    dist.Parent = screen

    local healthBg = Instance.new("Frame")
    healthBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    healthBg.BorderSizePixel = 0
    healthBg.Visible = false
    healthBg.ZIndex = 2
    healthBg.Parent = screen

    local health = Instance.new("Frame")
    health.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
    health.BorderSizePixel = 0
    health.Size = UDim2.new(1, 0, 1, 0)
    health.Position = UDim2.new(0, 0, 0, 0)
    health.AnchorPoint = Vector2.new(0, 1)
    health.ZIndex = 3
    health.Parent = healthBg

    local tracer = Instance.new("Frame")
    tracer.BackgroundColor3 = Settings.ESP.TracerColor
    tracer.BorderSizePixel = 0
    tracer.Visible = false
    tracer.ZIndex = 2
