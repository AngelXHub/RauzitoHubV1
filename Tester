local function criarToggle(parent, nome, padrao, callback)
    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, -4, 0, 32)
    item.BackgroundColor3 = COR.CARD_ITEM
    item.BorderSizePixel = 0
    item.Parent = parent
    local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(0, 6); ic.Parent = item

    local box = Instance.new("Frame")
    box.Size = UDim2.fromOffset(18, 18)
    box.Position = UDim2.fromOffset(8, 7)
    box.BackgroundColor3 = padrao and COR.ACCENT or Color3.fromRGB(40, 40, 44)
    box.BorderSizePixel = 0
    box.Parent = item
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 4); bc.Parent = box

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -80, 1, 0)
    lbl.Position = UDim2.fromOffset(34, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = nome
    lbl.TextColor3 = padrao and COR.TEXT or COR.TEXT_DIM
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = item

    local key = Instance.new("TextLabel")
    key.Size = UDim2.fromOffset(34, 22)
    key.Position = UDim2.new(1, -42, 0.5, -11)
    key.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
    key.BorderSizePixel = 0
    key.Text = "⊞"
    key.TextColor3 = COR.TEXT_DIM
    key.Font = Enum.Font.Gotham
    key.TextSize = 12
    key.Parent = item
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(0, 5); kc.Parent = key

    local state = padrao
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = item
    btn.MouseButton1Click:Connect(function()
        state = not state
        Services.TweenService:Create(box, TweenInfo.new(0.15), { BackgroundColor3 = state and COR.ACCENT or Color3.fromRGB(40, 40, 44) }):Play()
        Services.TweenService:Create(lbl, TweenInfo.new(0.15), { TextColor3 = state and COR.TEXT or COR.TEXT_DIM }):Play()
        if callback then pcall(callback, state) end
    end)
end

local function criarSlider(parent, nome, min, max, padrao, sufixo, callback)
    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, -4, 0, 55)
    item.BackgroundColor3 = COR.CARD_ITEM
    item.BorderSizePixel = 0
    item.Parent = parent
    local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(0, 6); ic.Parent = item

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, 0, 0, 20)
    lbl.Position = UDim2.fromOffset(10, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = nome
    lbl.TextColor3 = COR.TEXT
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = item

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0.4, -10, 0, 20)
    val.Position = UDim2.new(0.6, 0, 0, 6)
    val.BackgroundTransparency = 1
    val.Text = string.format("%.2f%s", padrao, sufixo or "")
    val.TextColor3 = COR.TEXT
    val.Font = Enum.Font.GothamMedium
    val.TextSize = 12
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = item

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 2)
    bar.Position = UDim2.fromOffset(10, 35)
    bar.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    bar.BorderSizePixel = 0
    bar.Parent = item

    local fill = Instance.new("Frame")
    local ratio = (padrao - min) / (max - min)
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = COR.ACCENT
    fill.BorderSizePixel = 0
    fill.Parent = bar

    local dragging = false
    local function update(input)
        local p = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * p
        v = math.floor(v * 100) / 100
        fill.Size = UDim2.new(p, 0, 1, 0)
        val.Text = string.format("%.2f%s", v, sufixo or "")
        if callback then pcall(callback, v) end
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(i)
        end
    end)
    Services.UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i)
        end
    end)
    Services.UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function criarDropdown(parent, nome, opcoes, padrao, callback)
    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, -4, 0, 55)
    item.BackgroundColor3 = COR.CARD_ITEM
    item.BorderSizePixel = 0
    item.Parent = parent
    local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(0, 6); ic.Parent = item

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.5, 0, 0, 20)
    lbl.Position = UDim2.fromOffset(10, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = nome
    lbl.TextColor3 = COR.TEXT
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = item

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0.5, -10, 0, 20)
    val.Position = UDim2.new(0.5, 0, 0, 6)
    val.BackgroundTransparency = 1
    val.Text = padrao .. "  ▾"
    val.TextColor3 = COR.TEXT
    val.Font = Enum.Font.GothamMedium
    val.TextSize = 12
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = item

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 2)
    bar.Position = UDim2.fromOffset(10, 35)
    bar.BackgroundColor3 = COR.ACCENT
    bar.BorderSizePixel = 0
    bar.Parent = item

    local idx = 1
    for i, o in ipairs(opcoes) do if o == padrao then idx = i break end end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = item
    btn.MouseButton1Click:Connect(function()
        idx = idx + 1
        if idx > #opcoes then idx = 1 end
        val.Text = opcoes[idx] .. "  ▾"
        if callback then pcall(callback, opcoes[idx]) end
    end)
end

