        o.BackgroundColor3 = Color3.fromRGB(35, 30, 50)
        o.Text = opt
        o.TextColor3 = Color3.fromRGB(220, 210, 245)
        o.Font = Enum.Font.Gotham
        o.TextSize = 12
        o.Parent = list
        o.MouseButton1Click:Connect(function()
            lbl.Text = text .. ": " .. opt
            list.Size = UDim2.new(1, 0, 0, 0)
            expanded = false
            callback(opt)
        end)
    end

    row.MouseButton1Click:Connect(function()
        expanded = not expanded
        list.Size = expanded and UDim2.new(1, 0, 0, #options * 36)
            or UDim2.new(1, 0, 0, 0)
    end)
    return row
end

function UI.build()
    local parent = getParent()

    local screen = Instance.new("ScreenGui")
    screen.Name = "LpModsUI"
    screen.ResetOnSpawn = false
    screen.IgnoreGuiInset = true
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent = parent

    local viewport = Camera.ViewportSize
    local isMobile = viewport.X < 900 or UserInputService.TouchEnabled
    local W = isMobile and math.min(viewport.X - 40, 400) or 440
    local H = isMobile and math.min(viewport.Y - 160, 480) or 460

    local main = Instance.new("Frame")
    main.Size = UDim2.fromOffset(W, H)
    main.Position = UDim2.new(0.5, -W / 2, 0.5, -H / 2)
    main.BackgroundColor3 = Settings.BgColor
    main.BorderSizePixel = 0
    main.Active = true
    main.Draggable = true
    main.Parent = screen
    local mc = Instance.new("UICorner")
    mc.CornerRadius = UDim.new(0, 12)
    mc.Parent = main
    local ms = Instance.new("UIStroke")
    ms.Color = Settings.AccentColor
    ms.Thickness = 1.4
    ms.Parent = main

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -90, 0, 40)
    title.Position = UDim2.new(0, 12, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = Settings.SystemName
    title.TextColor3 = Color3.fromRGB(235, 228, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 17
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = main

    local minBtn = Instance.new("TextButton")
    minBtn.Size = UDim2.fromOffset(34, 26)
    minBtn.Position = UDim2.new(1, -78, 0, 7)
    minBtn.BackgroundColor3 = Settings.RowColor
    minBtn.Text = "—"
    minBtn.TextColor3 = Color3.fromRGB(210, 200, 240)
    minBtn.Font = Enum.Font.GothamBold
    minBtn.TextSize = 15
    minBtn.Parent = main
    local minC = Instance.new("UICorner")
    minC.CornerRadius = UDim.new(0, 8)
    minC.Parent = minBtn

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.fromOffset(34, 26)
    closeBtn.Position = UDim2.new(1, -40, 0, 7)
    closeBtn.BackgroundColor3 = Color3.fromRGB(60, 20, 30)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.fromRGB(255, 180, 180)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 13
    closeBtn.Parent = main
    local closeC = Instance.new("UICorner")
    closeC.CornerRadius = UDim.new(0, 8)
    closeC.Parent = closeBtn

    closeBtn.MouseButton1Click:Connect(function()
        AimAssist.stop()
        SilentAim.stop()
        ESP.stop()
        ESP.clearAll()
        screen:Destroy()
    end)

    local tabBar = Instance.new("Frame")
    tabBar.Size = UDim2.new(1, -24, 0, 40)
    tabBar.Position = UDim2.new(0, 12, 0, 46)
    tabBar.BackgroundColor3 = Settings.PanelColor
    tabBar.BorderSizePixel = 0
    tabBar.Parent = main
    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(0, 10)
    tc.Parent = tabBar
    local tl = Instance.new("UIListLayout")
    tl.FillDirection = Enum.FillDirection.Horizontal
    tl.Padding = UDim.new(0, 5)
    tl.HorizontalAlignment = Enum.HorizontalAlignment.Center
    tl.VerticalAlignment = Enum.VerticalAlignment.Center
    tl.Parent = tabBar

    local pages = Instance.new("Frame")
    pages.Size = UDim2.new(1, -24, 1, -100)
    pages.Position = UDim2.new(0, 12, 0, 94)
    pages.BackgroundTransparency = 1
    pages.Parent = main

    local function makePage()
        local sf = Instance.new("ScrollingFrame")
        sf.Size = UDim2.new(1, 0, 1, 0)
        sf.BackgroundColor3 = Settings.PanelColor
        sf.BorderSizePixel = 0
        sf.ScrollBarThickness = 4
        sf.ScrollBarImageColor3 = Settings.AccentColor
        sf.CanvasSize = UDim2.new(0, 0, 0, 0)
        sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
        sf.Visible = false
        sf.Parent = pages
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 10)
        c.Parent = sf
        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 10)
        pad.PaddingBottom = UDim.new(0, 10)
        pad.PaddingLeft = UDim.new(0, 10)
        pad.PaddingRight = UDim.new(0, 10)
        pad.Parent = sf
        local list = Instance.new("UIListLayout")
        list.Padding = UDim.new(0, 8)
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Parent = sf
        return sf
    end

    local aimPage    = makePage()
    local silentPage = makePage()
    local espPage    = makePage()
    local setPage    = makePage()

    local function makeTab(label, page)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1/4, -4, 1, -8)
        b.BackgroundColor3 = Settings.RowColor
        b.Text = label
        b.TextColor3 = Color3.fromRGB(210, 200, 245)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.Parent = tabBar
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 7)
        c.Parent = b
        b.MouseButton1Click:Connect(function()
            for _, p in ipairs(pages:GetChildren()) do
                if p:IsA("ScrollingFrame") then p.Visible = false end
            end
            page.Visible = true
        end)
        return b
    end

    makeTab("Aim", aimPage)
    makeTab("Silent", silentPage)
    makeTab("ESP", espPage)
    makeTab("Settings", setPage)
    aimPage.Visible = true

    makeSection("AIM ASSIST", aimPage)
    makeToggle("Ativar Aim Assist", Settings.Aim.Enabled, function(v)
        Settings.Aim.Enabled = v
        if v then AimAssist.start() else AimAssist.stop() end
    end, aimPage)
    makeSlider("FOV", 20, 500, Settings.Aim.FOV, function(v)
        Settings.Aim.FOV = v
    end, aimPage)
    makeToggle("Mostrar FOV", Settings.Aim.ShowFOV, function(v)
        Settings.Aim.ShowFOV = v
    end, aimPage)
    makeDropdown("Parte do corpo", {"Head", "Torso", "HumanoidRootPart"},
        Settings.Aim.BodyPart, function(v)
            Settings.Aim.BodyPart = v
        end, aimPage)
    makeSlider("Máx. alvos", 1, 10, Settings.Aim.MaxTargets, function(v)
        Settings.Aim.MaxTargets = v
    end, aimPage)
    makeSlider("Suavização (x100)", 1, 100, math.floor(Settings.Aim.Smoothness * 100), function(v)
        Settings.Aim.Smoothness = v / 100
    end, aimPage)
    makeSlider("Distância máx.", 50, 2000, Settings.Aim.MaxDistance, function(v)
        Settings.Aim.MaxDistance = v
    end, aimPage)
    makeToggle("Team Check", Settings.Aim.TeamCheck, function(v)
        Settings.Aim.TeamCheck = v
    end, aimPage)
    makeToggle("Verificar vida", Settings.Aim.AliveCheck, function(v)
        Settings.Aim.AliveCheck = v
    end, aimPage)
    makeToggle("Wall Check (LOS)", Settings.Aim.WallCheck, function(v)
        Settings.Aim.WallCheck = v
    end, aimPage)

    makeSection("SILENT AIM", silentPage)
    makeToggle("Ativar Silent Aim", Settings.SilentAim.Enabled, function(v)
        Settings.SilentAim.Enabled = v
        if v then SilentAim.start() else SilentAim.stop() end
    end, silentPage)
    makeSlider("FOV", 20, 500, Settings.SilentAim.FOV, function(v)
        Settings.SilentAim.FOV = v
    end, silentPage)
    makeSlider("Distância máx.", 50, 2000, Settings.SilentAim.MaxDistance, function(v)
        Settings.SilentAim.MaxDistance = v
    end, silentPage)
    makeDropdown("Parte do corpo", {"Head", "Torso", "HumanoidRootPart"},
        Settings.SilentAim.BodyPart, function(v)
            Settings.SilentAim.BodyPart = v
        end, silentPage)
    makeSlider("Máx. alvos", 1, 10, Settings.SilentAim.MaxTargets, function(v)
        Settings.SilentAim.MaxTargets = v
    end, silentPage)
    makeToggle("Team Check", Settings.SilentAim.TeamCheck, function(v)
        Settings.SilentAim.TeamCheck = v
    end, silentPage)
    makeToggle("Wall Check (LOS)", Settings.SilentAim.WallCheck, function(v)
        Settings.SilentAim.WallCheck = v
    end, silentPage)

    local info = Instance.new("TextLabel")
    info.Size = UDim2.new(1, 0, 0, 60)
    info.BackgroundTransparency = 1
    info.Text = "Integração: no script de arma do jogo, consulte\n_G.LpMods.SilentAim.getAimPosition() no momento do disparo."
    info.TextColor3 = Color3.fromRGB(180, 170, 210)
    info.Font = Enum.Font.Gotham
    info.TextSize = 11
    info.TextWrapped = true
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.Parent = silentPage

    makeSection("ESP", espPage)

    local function espToggle(text, key)
        makeToggle(text, Settings.ESP[key], function(v)
            Settings.ESP[key] = v
            if ESP.isActive() then ESP.start() else ESP.stop() end
        end, espPage)
    end

    espToggle("ESP Box", "Box")
    espToggle("ESP Tracer", "Tracer")
    espToggle("ESP Name", "Name")
    espToggle("ESP Distance", "Distance")
    espToggle("ESP Health", "Health")
    espToggle("ESP Highlight", "Highlight")

    makeSlider("Distância máx. ESP", 50, 2000, Settings.ESP.MaxDistance, function(v)
        Settings.ESP.MaxDistance = v
    end, espPage)
    makeToggle("Team Check ESP", Settings.ESP.TeamCheck, function(v)
        Settings.ESP.TeamCheck = v
    end, espPage)

    makeSection("SISTEMA", setPage)
    makeSection("Nome: " .. Settings.SystemName, setPage)
    makeSection("Suporte: Delta / Arceus / Studio", setPage)

    local resetBtn = makeButton("Resetar ESP", setPage, 40)
    resetBtn.MouseButton1Click:Connect(function()
        ESP.clearAll()
        for _, p in ipairs(Players:GetPlayers()) do
            ESP.setupPlayer(p)
        end
    end)

    local stopAllBtn = makeButton("Desligar tudo", setPage, 40)
    stopAllBtn.MouseButton1Click:Connect(function()
        Settings.Aim.Enabled = false
        Settings.SilentAim.Enabled = false
        Settings.ESP.Box = false
        Settings.ESP.Tracer = false
        Settings.ESP.Name = false
        Settings.ESP.Distance = false
        Settings.ESP.Health = false
        Settings.ESP.Highlight = false
        AimAssist.stop()
        SilentAim.stop()
        ESP.stop()
        ESP.clearAll()
    end)

    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            pages.Visible = false
            tabBar.Visible = false
            TweenService:Create(main, TweenInfo.new(0.2),
                { Size = UDim2.fromOffset(W, 40) }):Play()
        else
            pages.Visible = true
            tabBar.Visible = true
            TweenService:Create(main, TweenInfo.new(0.2),
                { Size = UDim2.fromOffset(W, H) }):Play()
        end
    end)
end

Cleanup.bind()
UI.build()

RunService.RenderStepped:Connect(function()
    updateFovCircle()
end)

if ESP.isActive() then ESP.start() end
