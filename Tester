FOVCircle.Visible      = State.FOVVisible

local ESPCache = {}

local function createESPFor(player)
    local box = Drawing.new("Square")
    box.Thickness    = 1
    box.Filled       = false
    box.Transparency = 1
    box.Visible      = false

    local nameTag = Drawing.new("Text")
    nameTag.Size    = 14
    nameTag.Center  = true
    nameTag.Outline = true
    nameTag.Visible = false
    nameTag.Font    = 2

    ESPCache[player] = { box = box, name = nameTag }
end

local function removeESPFor(player)
    local entry = ESPCache[player]
    if not entry then return end
    if entry.box  then entry.box:Remove() end
    if entry.name then entry.name:Remove() end
    ESPCache[player] = nil
end

Players.PlayerAdded:Connect(createESPFor)
Players.PlayerRemoving:Connect(removeESPFor)
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createESPFor(p) end
end

RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    FOVCircle.Position  = center
    FOVCircle.Radius    = State.FOVSize
    FOVCircle.Thickness = State.FOVThickness
    FOVCircle.Color     = State.FOVColor
    FOVCircle.Visible   = State.FOVVisible

    for player, entry in pairs(ESPCache) do
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not (char and head and hrp and hum and hum.Health > 0) then
            entry.box.Visible  = false
            entry.name.Visible = false
        else
            local role = Util.getRole(player)
            local show = false
            local color = Color3.fromRGB(255, 255, 255)
            local label = role

            if role == "Murder" and State.ESP_Murder then
                show = true
                color = Color3.fromRGB(255, 60, 60)
            elseif role == "Sheriff" and State.ESP_Sheriff then
                show = true
                color = Color3.fromRGB(80, 160, 255)
            elseif role == "Innocent" and State.ESP_Innocent then
                show = true
                color = Color3.fromRGB(80, 255, 120)
            end

            if Util.isGunHolder(player) and State.ESP_Gun then
                show = true
                color = Color3.fromRGB(255, 220, 80)
                label = "Gun"
            end

            if not show then
                entry.box.Visible  = false
                entry.name.Visible = false
            else
                local topPos    = Util.worldToScreen(head.Position + Vector3.new(0, 0.5, 0))
                local bottomPos = Util.worldToScreen(hrp.Position - Vector3.new(0, 3, 0))
                if topPos and bottomPos then
                    local height = math.abs(bottomPos.Y - topPos.Y)
                    local width  = height * 0.6
                    entry.box.Size     = Vector2.new(width, height)
                    entry.box.Position = Vector2.new(topPos.X - width / 2, topPos.Y)
                    entry.box.Color    = color
                    entry.box.Visible  = true

                    entry.name.Text     = player.Name .. " | " .. label
                    entry.name.Position = Vector2.new(topPos.X, topPos.Y - 18)
                    entry.name.Color    = color
                    entry.name.Visible  = true
                else
                    entry.box.Visible  = false
                    entry.name.Visible = false
                end
            end
        end
    end
end)

local function getTargetInFOV()
    local target = Util.getMurderer()
    if not target then return nil end
    if Util.inFOV(target, State.SilentAimFOV) then
        return target
    end
    return nil
end

local mt = getrawmetatable and getrawmetatable(game)
if mt then
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if State.SilentAim and method == "FireServer" then
            local target = getTargetInFOV()
            if target then
                local head = Util.getHead(target)
                if head then
                    local args = {...}
                    return oldNamecall(self, head.Position, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

local speedConn
local function applySpeedGlitch()
    if speedConn then speedConn:Disconnect(); speedConn = nil end
    if not State.SpeedGlitch then return end

    speedConn = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 32
            hum.JumpPower = 60
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    applySpeedGlitch()
end)

local function teleportTo(player)
    if not player then return end
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local targetChar = player.Character
    local targetHRP  = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if hrp and targetHRP then
        hrp.CFrame = targetHRP.CFrame + Vector3.new(0, 2, 0)
    end
end

