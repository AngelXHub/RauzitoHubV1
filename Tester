local TeamCheck = {}

function TeamCheck.isAlly(player)
    if not Settings.ESP.TeamCheck
        and not Settings.Aim.TeamCheck
        and not Settings.SilentAim.TeamCheck then
        return false
    end
    if not player or not player.Team then return false end
    return player.Team == LocalPlayer.Team
end

function TeamCheck.shouldIgnore(player)
    if not player or player == LocalPlayer then return true end
    if TeamCheck.isAlly(player) then return true end
    return false
end

local Targeting = {}

local function getPart(player, partName)
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild(partName)
end

local function isAlive(player)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function hasLineOfSight(part, originPart)
    if not part then return false end
    local origin = originPart and originPart.Position or Camera.CFrame.Position

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LocalPlayer.Character,
        part.Parent,
    }

    local result = Workspace:Raycast(origin, part.Position - origin, params)
    return result == nil
end

function Targeting.screenPos(worldPos)
    local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
    if not onScreen then return nil end
    return Vector2.new(sp.X, sp.Y)
end

function Targeting.inFOV(player, fovPx, bodyPartName)
    local part = getPart(player, bodyPartName or "Head")
    if not part then return false end
    local sp = Targeting.screenPos(part.Position)
    if not sp then return false end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    return (sp - center).Magnitude <= fovPx
end

function Targeting.collect(cfg, teamCheckOn, aliveCheckOn, wallCheckOn)
    local results = {}
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return results end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local ignore = false
            if teamCheckOn and TeamCheck.shouldIgnore(player) then ignore = true end
            if aliveCheckOn and not isAlive(player) then ignore = true end

            if not ignore then
                local part = getPart(player, cfg.BodyPart)
                if part then
                    local dist = (part.Position - myHRP.Position).Magnitude
                    if dist <= cfg.MaxDistance then
                        local inFov = Targeting.inFOV(player, cfg.FOV, cfg.BodyPart)
                        if inFov then
                            local visible = true
                            if wallCheckOn then
                                visible = hasLineOfSight(part, myHRP)
                            end
                            if visible then
                                table.insert(results, {
                                    Player = player,
                                    Part   = part,
                                    Dist   = dist,
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(results, function(a, b) return a.Dist < b.Dist end)

    if cfg.MaxTargets and cfg.MaxTargets > 0 and #results > cfg.MaxTargets then
        local trimmed = {}
        for i = 1, cfg.MaxTargets do
            trimmed[i] = results[i]
        end
        return trimmed
    end
    return results
end

local AimAssist = {}

local currentTarget = nil
local aimConn = nil

local function pickTarget()
    local list = Targeting.collect(
        Settings.Aim,
        Settings.Aim.TeamCheck,
        Settings.Aim.AliveCheck,
        Settings.Aim.WallCheck
    )
    if #list == 0 then return nil end
    return list[1]
end

local function aimStep()
    if not Settings.Aim.Enabled then return end

    currentTarget = pickTarget()
    if not currentTarget then return end

    local targetPos = currentTarget.Part.Position
    local camPos    = Camera.CFrame.Position
    local goal      = CFrame.new(camPos, targetPos)

    local smooth = math.clamp(Settings.Aim.Smoothness, 0.01, 1)
    if smooth >= 0.999 then
        Camera.CFrame = goal
    else
        Camera.CFrame = Camera.CFrame:Lerp(goal, 1 - smooth)
    end
end

function AimAssist.start()
    if aimConn then return end
    aimConn = RunService.RenderStepped:Connect(aimStep)
end

function AimAssist.stop()
    if aimConn then aimConn:Disconnect(); aimConn = nil end
    currentTarget = nil
end

function AimAssist.getCurrentTarget()
    return currentTarget
end

--[[
    Silent Aim legítimo.
    Não hooka nada. Expõe SilentAim.getAimPosition() e SilentAim.getTarget().
    O LocalScript da arma do jogo chama essas funções no momento do disparo.
--]]
local SilentAim = {}

local silentTarget = nil
local silentConn   = nil

local function silentStep()
    if not Settings.SilentAim.Enabled then
        silentTarget = nil
        return
    end

    local list = Targeting.collect(
        Settings.SilentAim,
        Settings.SilentAim.TeamCheck,
        true,
        Settings.SilentAim.WallCheck
    )
    silentTarget = list[1] or nil
end

function SilentAim.start()
    if silentConn then return end
    silentConn = RunService.Heartbeat:Connect(silentStep)
end

function SilentAim.stop()
    if silentConn then silentConn:Disconnect(); silentConn = nil end
    silentTarget = nil
end

function SilentAim.getTarget()
    return silentTarget and silentTarget.Player or nil
end

function SilentAim.getAimPosition()
    return silentTarget and silentTarget.Part.Position or nil
end

