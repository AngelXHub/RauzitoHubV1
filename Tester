-- Resolve o parent correto da ScreenGui por executor.
-- Delta e Arceus modernos expõem gethui(); builds antigas usam get_hidden_gui().
local function getParent()
    if type(gethui) == "function" then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    if type(get_hidden_gui) == "function" then
        local ok, h = pcall(get_hidden_gui)
        if ok and h then return h end
    end
    if type(getgui) == "function" then
        local ok, h = pcall(getgui)
        if ok and h then return h end
    end
    return game:GetService("CoreGui")
end

